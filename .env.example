# Copie de référence des variables d'environnement. Les vraies valeurs se collent
# dans Vercel (Settings → Environment Variables), jamais dans le code.

# Adresse publique du site (facultatif : Vercel la fournit automatiquement).
NEXT_PUBLIC_SITE_URL=

# Étape 2 — Supabase (voir docs/etape-2-supabase.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : uniquement côté serveur, jamais exposée au navigateur.
SUPABASE_SECRET_KEY=

# Étape 6 — mesure d'audience Umami (identifiant du site, pas un secret).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
